{
    "name": "@doubleloop-io/oxlint-plugin-effect",
    "version": "0.1.0-rc.0",
    "description": "Oxlint rules for Effect 4 code",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/doubleloop-io/oxlint-plugin-effect.git"
    },
    "files": [
        "dist/",
        "RULES.md",
        "README.md",
        "LICENSE",
        "LICENSE.anti-slop"
    ],
    "type": "module",
    "exports": {
        "./presets/all": {
            "types": "./dist/presets/all.d.ts",
            "default": "./dist/presets/all.js"
        },
        "./presets/all.json": "./dist/presets/all.json"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "typecheck": "tsc --noEmit",
        "lint": "oxlint --deny-warnings",
        "test": "node --test rules-md.test.ts rules/*.test.ts",
        "check": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm test",
        "build": "rm -rf dist && tsc -p tsconfig.build.json && node presets/all-json.ts",
        "pack:check": "node --test presets/all-dist.test.ts && node scripts/pack-check.ts",
        "build-and-pack": "pnpm check && pnpm build && pnpm pack:check && pnpm smoke-test",
        "smoke-test": "node scripts/smoke-test.ts"
    },
    "dependencies": {
        "@oxlint/plugins": "^1.82.0"
    },
    "devDependencies": {
        "@types/node": "^24.13.6",
        "oxfmt": "0.67.0",
        "oxlint": "1.82.0",
        "publint": "^0.3.25",
        "typescript": "^7.0.2"
    },
    "peerDependencies": {
        "oxlint": "^1.82.0"
    },
    "engines": {
        "node": "^22.20.0 || >=24.8.0"
    },
    "packageManager": "pnpm@12.4.1"
}

{
    "name": "@doubleloop-io/oxlint-plugin-effect",
    "version": "0.1.0",
    "description": "Oxlint rules for Effect 4 code",
    "homepage": "https://doubleloop-io.github.io/oxlint-plugin-effect/",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/doubleloop-io/oxlint-plugin-effect.git"
    },
    "files": [
        "dist/",
        "docs/user-guide/",
        "README.md",
        "CHANGELOG.md",
        "LICENSE",
        "LICENSE.anti-slop"
    ],
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./presets/all": {
            "types": "./dist/presets/all.d.ts",
            "default": "./dist/presets/all.js"
        },
        "./presets/all.json": "./dist/presets/all.json"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "typecheck": "tsc --noEmit",
        "lint": "oxlint --deny-warnings",
        "test": "node --test src/rule-files.test.ts src/rules/*.test.ts src/shared/*.test.ts",
        "check": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm test",
        "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/preset-all-json.ts",
        "build:w": "node --watch-path=src --watch-path=tsconfig.build.json scripts/build.ts",
        "pack:check": "node --test scripts/preset-all-dist-check.ts && node scripts/pack-check.ts",
        "build-and-pack": "pnpm check && pnpm build && pnpm pack:check && pnpm consumer-test",
        "consumer-test": "node scripts/consumer-test.ts",
        "changeset-version": "changeset version && pnpm format",
        "changeset-publish": "pnpm build-and-pack && changeset publish",
        "changeset-status": "changeset status --verbose",
        "consumer:link": "./scripts/link-consumer.sh link",
        "consumer:unlink": "./scripts/link-consumer.sh unlink"
    },
    "dependencies": {
        "@oxlint/plugins": "^1.82.0"
    },
    "devDependencies": {
        "@changesets/changelog-github": "^1.0.1",
        "@changesets/cli": "^3.0.3",
        "@types/node": "^24.13.6",
        "oxfmt": "0.67.0",
        "oxlint": "1.82.0",
        "publint": "^0.3.25",
        "typescript": "^7.0.2"
    },
    "peerDependencies": {
        "oxlint": "^1.82.0"
    },
    "engines": {
        "node": "^22.20.0 || >=24.8.0"
    },
    "packageManager": "pnpm@12.4.1"
}
